544ad19700de8ec0d9747ae83ab1df25b2c89c3159320972c46803d5f31a1a62ba8b8b411043d68dbdbe379d5f6f1d2a4bfd2a79650242a7dab4c771f845fa68  0001-qnx-fixes.patch
"
